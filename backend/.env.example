PORT=8080
DATABASE_URL=postgres://worklingo:worklingo@localhost:5433/worklingo?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Startup selectors: openai or gemini. Role selectors override LLM_PROVIDER.
LLM_PROVIDER=openai
LLM_CHAT_PROVIDER=
LLM_EVAL_PROVIDER=

# Legacy OpenAI-compatible endpoint (9router); used only by openai roles.
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=your-api-key-here
LLM_CHAT_MODEL=cc/claude-haiku-4-5-20251001
LLM_EVAL_MODEL=cc/claude-sonnet-5-5
LLM_TIMEOUT=120s

# Gemini OpenAI compatibility; used only by gemini roles. Keys stay backend-only.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EVAL_MODEL=gemini-3.1-flash-lite

# Game timings (Go durations: 30s, 5m, 1h)
SESSION_DURATION=60m
RESPONSE_TIMEOUT=5m
TASK_FIRST_DELAY=2m
TASK_MIN_INTERVAL=6m
TASK_MAX_INTERVAL=12m
