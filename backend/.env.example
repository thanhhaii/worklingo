PORT=8080
DATABASE_URL=postgres://worklingo:worklingo@localhost:5433/worklingo?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# OpenAI-compatible endpoint (9router)
LLM_BASE_URL=http://127.0.0.1:20128/v1
LLM_API_KEY=your-api-key-here
LLM_CHAT_MODEL=cc/claude-haiku-4-5-20251001
LLM_EVAL_MODEL=cc/claude-sonnet-5-5
LLM_TIMEOUT=120s

# Game timings (Go durations: 30s, 5m, 1h)
SESSION_DURATION=60m
RESPONSE_TIMEOUT=5m
TASK_FIRST_DELAY=2m
TASK_MIN_INTERVAL=6m
TASK_MAX_INTERVAL=12m
