# Public hostname (no scheme), e.g. worklingo.example.com
DOMAIN=worklingo.example.com

# openssl rand -hex 24 / openssl rand -hex 48
POSTGRES_PASSWORD=
JWT_SECRET=

# Where the gateway listens on the host (host nginx proxies here)
GATEWAY_BIND=127.0.0.1:8088

# Only with `--profile tunnel` (Cloudflare Tunnel instead of host nginx)
CLOUDFLARE_TUNNEL_TOKEN=

# Provider selection is read at backend startup. Role overrides are optional.
LLM_PROVIDER=openai
LLM_CHAT_PROVIDER=
LLM_EVAL_PROVIDER=

# Used by openai roles only; may remain empty when all roles use Gemini.
LLM_BASE_URL=https://platform.beeknoee.com/api/v1
LLM_API_KEY=
LLM_CHAT_MODEL=claude-haiku-4-5-20251001
LLM_EVAL_MODEL=claude-sonnet-4-6
LLM_TIMEOUT=120s

# Used by gemini roles only. Never put API keys in frontend env vars.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EVAL_MODEL=gemini-3.1-flash-lite
