# Public hostname (no scheme), e.g. worklingo.example.com
DOMAIN=worklingo.example.com

# openssl rand -hex 24 / openssl rand -hex 48
POSTGRES_PASSWORD=
JWT_SECRET=

# Where the gateway listens on the host (host nginx proxies here)
GATEWAY_BIND=127.0.0.1:8088

# Only with `--profile tunnel` (Cloudflare Tunnel instead of host nginx)
CLOUDFLARE_TUNNEL_TOKEN=

LLM_BASE_URL=https://platform.beeknoee.com/api/v1
LLM_API_KEY=
LLM_CHAT_MODEL=claude-haiku-4-5-20251001
LLM_EVAL_MODEL=claude-sonnet-4-6
